# Red docker externa compartida con el Traefik del host. Opcional:
# también se puede pasar con --env-file o exportarla.
TRAEFIK_NETWORK=traefik

# La base de datos y la app leen el resto de las variables (MYSQL_*,
# SMTP_*, OCI_*) desde el .env de la raíz del repo (env_file de ambos
# servicios). Copie .env.example a .env y complete ahí.

# Solo si el .env de la raíz no define MYSQL_ROOT_PASSWORD (dev usa cipse_root):
MYSQL_ROOT_PASSWORD=cipse_root_dev_no_reutilizar_en_prod

