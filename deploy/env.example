# El stack (traefik + app + db) lee este archivo y el .env de la raíz del
# repo (app y db vía env_file). Copie .env.example a .env y complete ahí.

# Solo necesario si el .env de la raíz no define MYSQL_ROOT_PASSWORD
# (el compose de desarrollo usa cipse_root):
MYSQL_ROOT_PASSWORD=cipse_root_dev_no_reutilizar_en_prod
