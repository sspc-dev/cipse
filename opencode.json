{
      "$schema": "https://opencode.ai/config.json",
      "mcp": {
            "heroui-react": {
                  "type": "local",
                  "command": [
                        "npx",
                        "-y",
                        "@heroui/react-mcp@latest"
                  ]
            },
            "stitch": {
                  "type": "remote",
                  "url": "https://stitch.googleapis.com/mcp",
                  "enabled": true,
                  "headers": {
                        "X-Goog-Api-Key": ""
                  }
            }
      }
}